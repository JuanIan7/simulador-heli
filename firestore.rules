rules_version = '2';
// Regras do banco do Simulador Heli. Colar em Firestore Database › Regras e publicar.
// jogadores/{uid}: apelido e progresso (todos os jogadores logados leem, para o ranking; cada um só grava o seu).
// privado/{uid}: e-mail e acessos (só o dono e o desenvolvedor).
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() { return request.auth != null; }
    function admin() {
      return logado() && request.auth.token.email_verified == true
        && request.auth.token.email in ['juanhanzi@gmail.com'];
    }
    function dono(uid) { return logado() && request.auth.uid == uid; }
    // texto opcional com limite de tamanho (o app já limpa; aqui é a trava do servidor)
    function txt(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function dataIso(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    match /jogadores/{uid} {
      allow read: if logado();
      allow create, update: if admin() || (dono(uid)
        && request.resource.data.apelido is string
        && request.resource.data.apelido.size() >= 2
        && request.resource.data.apelido.size() <= 24);
      allow delete: if admin();
    }
    match /privado/{uid} {
      allow read, write: if dono(uid) || admin();
    }
    // Diário de voo: cada piloto só lê e grava o próprio (nem o desenvolvedor vê).
    match /diario/{uid} {
      allow read: if dono(uid);
      allow delete: if dono(uid);
      allow create, update: if dono(uid) && txt(request.resource.data, 'nome', 80)
        && txt(request.resource.data, 'canac', 6) && txt(request.resource.data, 'matricula', 8) && txt(request.resource.data, 'origem', 4);
      match /voos/{voo} {
        allow read, delete: if dono(uid);
        allow create, update: if dono(uid) && dataIso(request.resource.data.data)
          && txt(request.resource.data, 'matricula', 8) && txt(request.resource.data, 'origem', 4) && txt(request.resource.data, 'destino', 4)
          && txt(request.resource.data, 'instrutor', 80) && txt(request.resource.data, 'obs', 2000)
          && txt(request.resource.data, 'missao', 40) && txt(request.resource.data, 'parecer', 600);
      }
      // "Voou hoje?": um registro por dia (voou ou o motivo de não ter voado). Só o dono.
      match /dias/{dia} {
        allow read, delete: if dono(uid);
        allow create, update: if dono(uid) && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.voou is bool
          && request.resource.data.motivo in ['', 'chuva', 'vento', 'fds', 'outro'] && txt(request.resource.data, 'outro', 60);
      }
      // Documentos do voo (foto/PDF do Diário de Bordo e da Ficha de Avaliação), em partes de até 700 mil caracteres.
      match /docs/{d} {
        allow read, delete: if dono(uid);
        allow create, update: if dono(uid) && request.resource.data.tipo in ['db', 'ficha']
          && request.resource.data.voo is string && request.resource.data.voo.size() <= 80
          && txt(request.resource.data, 'nome', 120) && txt(request.resource.data, 'mime', 40)
          && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 16;
        match /partes/{n} {
          allow read, delete: if dono(uid);
          allow create, update: if dono(uid) && request.resource.data.b64 is string && request.resource.data.b64.size() <= 700000;
        }
      }
    }
    // Gastos da turma: quem tem o código do grupo entra (gastosMembros) e, a partir daí, lê e lança os gastos de todos.
    function membroGastos() { return logado() && exists(/databases/$(db)/documents/gastosMembros/$(request.auth.uid)); }
    match /gastosConvites/{codigo} {
      allow get: if logado();
      allow list, create, delete: if admin();
      allow update: if admin() || (membroGastos()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pessoas'])
        && request.resource.data.pessoas.size() <= 60);
    }
    // Cada nome da turma tem um dono só: gastosNomes/{codigo}|{nome} = { uid }. Criar falha se o nome já tem dono.
    match /gastosNomes/{id} {
      allow get: if logado();
      allow list: if admin();
      allow create: if admin() || (logado() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.codigo + '|' + request.resource.data.nome);
      allow update: if admin();
      allow delete: if admin() || (logado() && resource.data.uid == request.auth.uid);
    }
    match /gastosMembros/{uid} {
      allow read: if membroGastos() || dono(uid) || admin();
      // só entra com um nome reservado para a própria conta (o app grava os dois juntos)
      allow create: if dono(uid) && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 24
        && exists(/databases/$(db)/documents/gastosConvites/$(request.resource.data.codigo))
        && getAfter(/databases/$(db)/documents/gastosNomes/$(request.resource.data.codigo + '|' + request.resource.data.nome)).data.uid == request.auth.uid;
      // ninguém troca o próprio nome sozinho (viraria outra pessoa nos acertos); o administrador corrige
      allow update: if admin() || (dono(uid) && request.resource.data.codigo == resource.data.codigo
        && request.resource.data.nome == resource.data.nome);
      allow delete: if dono(uid) || admin();
    }
    // Materiais acrescentados pela turma: todos os membros leem e acrescentam; cada um tira o que pôs.
    match /materiais/{id} {
      allow read: if membroGastos() || admin();
      allow create: if (membroGastos() || admin())
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 2 && request.resource.data.titulo.size() <= 120
        && request.resource.data.link is string && request.resource.data.link.matches('https://.+') && request.resource.data.link.size() <= 1000
        && request.resource.data.secao in ['eacar', 'essenciais', 'sn', 'esquilo', 'outros'];
      allow update: if admin();
      allow delete: if admin() || (membroGastos() && resource.data.autor == request.auth.uid);
    }
    // Lista de compras da turma: os membros leem, põem, marcam como comprado e tiram.
    match /compras/{id} {
      allow read, delete: if membroGastos() || admin();
      allow create, update: if (membroGastos() || admin())
        && request.resource.data.item is string && request.resource.data.item.size() >= 2 && request.resource.data.item.size() <= 80
        && txt(request.resource.data, 'qtd', 30) && txt(request.resource.data, 'nome', 24) && txt(request.resource.data, 'feitoPor', 24)
        && request.resource.data.cat in ['mercado', 'casa', 'higiene', 'roupa', 'curso', 'outros']
        && request.resource.data.feito is bool;
    }
    // Anotações da turma (o que fazer, lugar para ir, tarefa): os membros leem, anotam, marcam como feito e apagam.
    match /anotacoes/{id} {
      allow read, delete: if membroGastos() || admin();
      allow create, update: if (membroGastos() || admin())
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 2 && request.resource.data.texto.size() <= 300
        && txt(request.resource.data, 'quando', 40) && txt(request.resource.data, 'nome', 24) && txt(request.resource.data, 'feitoPor', 24)
        && request.resource.data.tipo in ['fazer', 'lugar', 'tarefa', 'ideia', 'outros']
        && request.resource.data.feito is bool;
    }
    // Provas da turma: cada um grava só as próprias notas; todos os membros leem (ranking).
    match /provas/{uid} {
      allow read: if membroGastos() || admin();
      allow create, update: if dono(uid) && (membroGastos() || admin())
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 24
        && request.resource.data.notas is map && request.resource.data.notas.size() <= 30;
      allow delete: if dono(uid) || admin();
    }
    match /gastos/{id} {
      allow read, delete: if membroGastos() || admin();
      allow create, update: if (membroGastos() || admin())
        && request.resource.data.valor is int && request.resource.data.valor > 0
        && request.resource.data.valor <= 10000000 && dataIso(request.resource.data.data)
        && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 80
        && txt(request.resource.data, 'obs', 120)
        && request.resource.data.participantes is list && request.resource.data.participantes.size() <= 60;
    }
  }
}
